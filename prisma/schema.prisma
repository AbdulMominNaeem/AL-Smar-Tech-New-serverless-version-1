datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SiteData {
  id        Int      @id @default(1)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  website   String?
  services  String?
  message   String
  createdAt DateTime @default(now())
}